# Copy to ai_scalper/.env and fill in. That exact name is already covered by .gitignore, so it
# will not be committed. Keep real secrets ONLY in .env — never in this example file.

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_SSL=false
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Trained model exposing predict_proba with classes ordered [short, neutral, long].
# Omit to use the baseline heuristic in baseline_model.py.
# MODEL_PATH=

# Enables the LLM decision path in llm_supervisor.py; without it the supervisor uses rules only.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Needed for keystore-encrypted hbot operations (e.g. `hbot stop` under --apply).
# HBOT_PASSWORD=
